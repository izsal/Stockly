# Neon PostgreSQL (pooled connection untuk runtime aplikasi)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=verify-full"

# Opsional: Neon direct connection (unpooled)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB_NAME?sslmode=verify-full"

# Better Auth (minimal 32 karakter acak, generate dengan: openssl rand -base64 32)
BETTER_AUTH_SECRET="replace-with-a-cryptographically-random-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# URL aplikasi publik (opsional)
NEXT_PUBLIC_APP_URL="http://localhost:3000"